# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.

# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (эти же значения использует docker compose)
POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Как часто обновлять цены, секунды
PRICE_UPDATE_INTERVAL=300

# Рыночные данные: iss (по умолчанию, без токена) или tinvest
MARKET_DATA_PROVIDER=iss
ISS_BASE_URL=https://iss.moex.com/iss
ISS_BOARD=TQBR
MARKET_DATA_TIMEOUT=30

# Только для MARKET_DATA_PROVIDER=tinvest. Нужен токен только на чтение.
TINVEST_TOKEN=
TINVEST_TARGET=invest-public-api.tbank.ru:443
# Путь к PEM-файлу с корневым сертификатом, если он нужен для соединения
TINVEST_ROOT_CA_PATH=
